@startuml Jeu
title Jeu - Combat de robots (généré depuis le code)

' =====================
' Config défaut
' =====================
class Config <<record>> {
    + port: int = 3000
    + ipAddress: string = "192.168.2.173"
    + maxPlayers: int = 1
    + pointsToGive: int = 10
    + baseEnergy: int = 2
    + maxEnergy: int = 5
    + powerDamageEnergyCost: int = 2
    + powerDamageMultiplier: int = 2
    + rechargeEnergyGain: int = 1
    + baseHp: int = 100
    + baseArmor: int = 0
    + baseDamage: int = 10
    + hpPerPoint: int = 10
    + armorPerPoint: int = 2
    + damagePerPoint: int = 2
    + defenseBonus: int = 5
}

' =====================
' Jeu
' =====================
enum GameStatus {
    WAITING_FOR_PLAYER
    WAITING_FOR_PLAYER_CONFIG
    WAITING_FOR_HOST_CONFIG
    PLAYING
    END_GAME
}

enum GameAction {
    ATTACK
    DEFENSE
    ATTACK_PUISSANCE
    RECHARGE
}

class GameActionCompanion <<static>> {
    + {static} resultOfAction(action: GameAction, result: int): string
}

class GameController {
    + isHost: boolean {readOnly}
    - config: Config
    - view: IGameView
    - menu: CommandMenu
    - socket: ISocket
    - sync: object
    - hostRobotConfig: RobotConfig?
    - playerRobotConfig: RobotConfig?
    - localTurn: boolean
    + currentGame: Game? {readOnly}
    + isLocalTurn: boolean {readOnly}
    + opponentWantsReplay: boolean {readOnly}
    + GameController(isHost: boolean, config: Config, view: IGameView, menu: CommandMenu, socket: ISocket)
    + getGameStatus(): GameStatus
    + startGame(): Task
    + disconnect(): void
    + askLocalConfig(): Task
    + handleClientConfig(robotConfig: RobotConfig?): Task
    + configureHost(hostConfig: RobotConfig): void
    + configurePlayer(playerConfig: RobotConfig): void
    - resetIfEnded(): void
    + createGame(): void
    - startHostGameAsync(): Task
    + replay(): Task
    + onOpponentReplay(): void
    + executeActionAsync(action: GameAction): Task
    + handleClientActionAsync(action: GameAction): Task
    - resolveActionAsync(action: GameAction): Task<boolean>
    - sendTurnAsync(): Task
    + applyServerStart(data: string): void
    + applyServerTurn(data: string): void
    + applyServerError(data: string): void
    + applyServerResult(action: GameAction, data: string): void
    - showActionResult(hostActed: boolean, action: GameAction, damage: int): void
    - buildStateData(): string
    - {static} parseState(parts: string[], offset: int): int[]
    - {static} turnName(host: boolean): string
    + showWinnerIfEnded(): void
    + displayFight(): void
    + send(type: MessageType, action: GameAction?, data: string): Task
    + listen(): Task
    - onMessageReceived(message: Message): void
}

class Game {
    - id: string
    + robots: List<Robot> {readOnly}
    - status: GameStatus
    - currentPlayer: int
    + Id: string {readOnly}
    + Status: GameStatus {readOnly}
    + currentRobot: Robot {readOnly}
    + opponentRobot: Robot {readOnly}
    + Game(config: Config, hostRobot: Robot, playerRobot: Robot)
    + startGame(): void
    + applyAction(action: GameAction): int
    + copyState(hpHost: int, hpClient: int, energyHost: int, energyClient: int): void
    + checkGameEnded(): boolean
    + getWinner(): Robot?
}

class RobotConfig {
    + hpPoints: int
    + armorPoints: int
    + damagePoints: int
    + isValid(): boolean
}

class Robot {
    + isHost: boolean {readOnly}
    - isDefending: boolean
    - stats: List<Stats>
    + Robot(isHost: boolean, robotConfig: RobotConfig, config: Config)
    + isAlive(): boolean
    + attack(): int
    + canAttackWithPower(): boolean
    + attackWithPower(): int
    + recharge(): void
    + defend(): void
    + receiveDamage(damage: int): int
    + getStats(type: StatsType): string
    + forceStat(hp: int, energy: int): void
    - resetDefend(): void
    - getStat(type: StatsType): Stats
}

enum StatsType {
    HP
    ATTACK
    DEFENSE
    ENERGY
}

class Stats {
    + type: StatsType {readOnly}
    + currentValue: int
    + Stats(type: StatsType, baseValue: int)
    + increase(value: int, maxValue: int): void
    + decrease(amount: int): void
    + toString(): string
}

' =====================
' Messages
' =====================
enum MessageType {
    CREATE
    JOIN
    WELCOME
    SERVER_BUSY
    ROBOT
    ROBOT_OK
    ERROR
    START
    TURN
    ACTION
    RESULT
    END
    REPLAY
    REPLAY_OK
    QUIT
    QUIT_OK
}

class Message <<record>> {
    + messageType: MessageType
    + action: GameAction?
    + data: string
    + status: GameStatus
}

class MessageHelper {
    - {static} jsonSerializerOption: JsonSerializerOptions
    + {static} buildMessage(type: MessageType, action: GameAction?, status: GameStatus, data: string): string
    + {static} parseMessage(message: string): Message
}

class SerializeException {
    + SerializeException(message: string, cause: Exception?)
}

class Exception

' =====================
' Connexion Socket
' =====================
interface ISocket {
    + start(): Task
    + send(message: string): Task
    + receive(): Task<string?>
    + exit(): void
    + isConnected(): boolean
}

class SocketServer {
    - port: int
    - ip: string
    - isRunning: boolean
    - listener: Socket?
    - connection: ConnectionHandler?
    - disposed: boolean
    - isClientConnected: boolean
    + SocketServer(port: int, ip: string)
    + start(): Task
    + startServer(): void
    + waitForClient(): Task
    - acceptLoop(): Task
    + receive(): Task<string?>
    + exit(): void
    + send(message: string): Task
    + isConnected(): boolean
}

class SocketClient {
    - {static} BUSY_MESSAGE: string = "SERVER_BUSY"
    - ipAddress: string
    - port: int
    - connection: ConnectionHandler?
    + SocketClient(ipAddress: string, port: int)
    + send(message: string): Task
    + receive(): Task<string?>
    + exit(): void
    + start(): Task
    + isConnected(): boolean
    - connectToServer(): Task
}

interface IDisposable {
    + dispose(): void
}

class ConnectionHandler {
    - {static} EOM: string = "<|EOM|>"
    - socket: Socket
    - stopped: boolean
    - pending: StringBuilder
    - decoder: Decoder
    + ConnectionHandler(socket: Socket)
    + isConnected(): boolean
    + sendMessage(message: string): Task
    + receiveMessage(): Task<string?>
    + dispose(): void
}

' =====================
' Vue
' =====================
interface IGameView {
    + askPlayerType(): string
    + askPlayerHostInformations(): string[]
    + askHostPortInformation(): int
    + showMessage(message: string): void
    + showWinner(robot: Robot): void
    + askPlayerConfig(): RobotConfig
    + askPlayerAction(): GameAction
    + displayFight(localRobot: Robot, remoteRobot: Robot): void
    + askPlayerReplay(): boolean
}

class ConsoleView {
    - config: Config
    + ConsoleView(config: Config)
    + askHostPortInformation(): int
    + askPlayerAction(): GameAction
    + askPlayerConfig(): RobotConfig
    + askPlayerHostInformations(): string[]
    + askPlayerReplay(): boolean
    + askPlayerType(): string
    + showMessage(message: string): void
    + showWinner(robot: Robot): void
    + displayFight(localRobot: Robot, remoteRobot: Robot): void
    - displayRobotConfig(robotConfig: RobotConfig): void
    - displayRepartPoints(pointsRemaining: int): void
}

' =====================
' Handlers des messages reçus (patron Commande)
' =====================
interface ICommand {
    + handle(message: Message): void
}

class CommandMenu {
    - handlers: Dictionary<MessageType, ICommand>
    + addHandler(messageType: MessageType, command: ICommand): void
    + execute(message: Message): void
}

class PlayerJoinHandler <<WELCOME>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
}
class RobotReadyHandler <<ROBOT>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
    - {static} parseRobotConfig(data: string): RobotConfig?
}
class PlayerActionHandler <<ACTION>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
}
class PlayerResultHandler <<START / TURN / RESULT / ERROR>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
}
class PlayerReplayHandler <<REPLAY>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
}
class QuitHandler <<QUIT>> {
    - controller: GameController
    - view: IGameView
    + handle(message: Message): void
}
class PlayerLeaveHandler {
    - view: IGameView
    + handle(message: Message): void
}
class StartHandler {
    - view: IGameView
    + handle(message: Message): void
}

note bottom of StartHandler
  PlayerLeaveHandler et StartHandler existent
  mais ne sont pas enregistrés dans Program.cs
end note

' =====================
' Relations
' =====================

' --- Contrôleur
GameController "1" --> "1" Config
GameController "1" --> "1" IGameView
GameController "1" o-- "1" CommandMenu
GameController "1" o-- "1" ISocket
GameController "1" *-- "0..1" Game : currentGame
GameController "1" --> "0..2" RobotConfig : hostRobotConfig\nplayerRobotConfig
GameController ..> Robot : <<create>>
GameController ..> MessageHelper : <<use>>

' --- Jeu
Game "1" o-- "2" Robot : robots
Game --> GameStatus
Game ..> GameAction
Game ..> Config
Robot "1" *-- "4" Stats
Robot ..> RobotConfig
Robot ..> Config
Stats "*" --> "1" StatsType
GameActionCompanion ..> GameAction

' --- Messages
Message --> MessageType
Message --> GameAction
Message --> GameStatus
MessageHelper ..> Message
MessageHelper ..> SerializeException : <<throw>>
Exception <|-- SerializeException

' --- Sockets
ISocket <|.. SocketServer
ISocket <|.. SocketClient
IDisposable <|.. ConnectionHandler
SocketServer "1" o-- "0..1" ConnectionHandler
SocketClient "1" o-- "0..1" ConnectionHandler

' --- Vue
IGameView <|.. ConsoleView
ConsoleView --> "1" Config

' --- Handlers
CommandMenu "1" o-- "*" ICommand
CommandMenu ..> Message
ICommand ..> Message
ICommand <|.. PlayerJoinHandler
ICommand <|.. RobotReadyHandler
ICommand <|.. PlayerActionHandler
ICommand <|.. PlayerResultHandler
ICommand <|.. PlayerReplayHandler
ICommand <|.. QuitHandler
ICommand <|.. PlayerLeaveHandler
ICommand <|.. StartHandler

PlayerJoinHandler --> GameController
RobotReadyHandler --> GameController
PlayerActionHandler --> GameController
PlayerResultHandler --> GameController
PlayerReplayHandler --> GameController
QuitHandler --> GameController

PlayerJoinHandler --> IGameView
RobotReadyHandler --> IGameView
PlayerActionHandler --> IGameView
PlayerResultHandler --> IGameView
PlayerReplayHandler --> IGameView
QuitHandler --> IGameView
PlayerLeaveHandler --> IGameView
StartHandler --> IGameView
RobotReadyHandler ..> RobotConfig : <<create>>
@enduml
